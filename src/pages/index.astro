  { href: "#dibujos", titulo: { es: "Dibujos", en: "Drawings" }, texto: { es: "Lo que he dibujado", en: "What I’ve drawn" } },
  { href: "#certificados", titulo: { es: "Certificados", en: "Certificates" }, texto: { es: "Lo que he estudiado", en: "What I’ve studied" } },
  { href: "#logros", titulo: { es: "Logros", en: "Achievements" }, texto: { es: "Lo que he conseguido", en: "What I’ve achieved" } },
  { href: "#contacto", titulo: { es: "Contacto", en: "Contact" }, texto: { es: "Hablemos", en: "Let’s talk" } },
];

// img: null = marco vacío. Cuando tengas la captura, pon ruta("/img/academia.webp")
const proyectos = [
  {
    nombre: "La Academia",
    fecha: { es: "Web en producción · Jul-Ago 2026", en: "Live website · Jul–Aug 2026" },
    img: null,
    alt: "Captura de la web de La Academia",
    texto: {
      es: "Web de una academia de refuerzo de Arroyo de la Miel, hecha en equipo de dos. Diseñé la identidad visual, el header, el footer, el inicio, las animaciones y el popup de reserva, y monté el servidor en PHP y la base de datos en Hostinger.",
      en: "Website for a tutoring academy in Arroyo de la Miel, built by a team of two. I designed the visual identity, header, footer, home page, animations and booking popup, and set up the PHP server and the database on Hostinger.",
    },
    tecnologias: { es: "HTML, CSS, JavaScript, PHP, MySQL", en: "HTML, CSS, JavaScript, PHP, MySQL" },
    demo: "https://laacademiasc.es",
    codigo: null,
  },
  {
    nombre: "ASTI Robotics Challenge",
    fecha: { es: "Concurso · Mar 2026", en: "Contest · Mar 2026" },
    img: null,
    alt: "Foto del equipo en el ASTI Robotics Challenge",
    texto: {
      es: "Concurso de robótica educativa en equipo de cuatro. Me encargué del marketing, del diseño visual y de la planificación económica.",
      en: "Educational robotics contest, team of four. I handled marketing, visual design and financial planning.",
    },
    tecnologias: { es: "Marketing, diseño, gestión económica", en: "Marketing, design, financial planning" },
    demo: null,
    codigo: null,
  },
  {
    nombre: "Málaga Business Bootcamp",
    fecha: { es: "Bootcamp · Ene 2026", en: "Bootcamp · Jan 2026" },
    img: null,
    alt: "Equipo del Málaga Business Bootcamp",
    texto: {
      es: "Proyecto web para un emprendedor local con estudiantes neerlandeses de Sint Lucas, en inglés. Aporté ideas y diseñé los elementos de la página.",
      en: "Web project for a local entrepreneur with Dutch students from Sint Lucas, working in English. I contributed ideas and designed the page elements.",
    },
    tecnologias: { es: "Diseño web, trabajo en inglés", en: "Web design, working in English" },
    demo: null,
    codigo: null,
  },
];

// De momento son tus marcos de ejemplo. Sustitúyelos por tus dibujos (de 6 a 8 se ven bien).
const dibujos = [
  { img: ruta("/img/dibujo-1.svg"), alt: "Descripción del dibujo 1", titulo: "Dibujo 1" },
  { img: ruta("/img/dibujo-2.svg"), alt: "Descripción del dibujo 2", titulo: "Dibujo 2" },
  { img: ruta("/img/dibujo-3.svg"), alt: "Descripción del dibujo 3", titulo: "Dibujo 3" },
  { img: ruta("/img/dibujo-4.svg"), alt: "Descripción del dibujo 4", titulo: "Dibujo 4" },
];

const certificados = [
  { img: ruta("/img/erasmuslogo.png"), alt: "Diploma del concurso de logo de Erasmus+", titulo: { es: "Erasmus+: ganadora del concurso internacional de logo", en: "Erasmus+: international logo contest winner" }, anio: "2024" },
  { img: ruta("/img/erasmus+.png"), alt: "Certificado de Erasmus+ y eTwinning", titulo: { es: "Erasmus+ y eTwinning", en: "Erasmus+ and eTwinning" }, anio: "2024" },
  { img: ruta("/img/hackatonOracle.jpeg"), alt: "Diploma del hackatón de Oracle y CIFAL", titulo: { es: "1.er premio Hackatón Oracle y CIFAL Málaga (UNITAR)", en: "1st prize, Oracle and CIFAL Málaga (UNITAR) hackathon" }, anio: "2024" },
  { img: ruta("/img/holandaErasmus.png"), alt: "Certificado del Málaga Business Bootcamp", titulo: { es: "Málaga Business Bootcamp · Digitech x Sint Lucas", en: "Málaga Business Bootcamp · Digitech x Sint Lucas" }, anio: "2026" },
];

const logros = [
  {
    anio: "2024",
    titulo: { es: "1.er premio Hackatón Oracle y CIFAL Málaga", en: "1st prize at the Oracle and CIFAL Málaga hackathon" },
    texto: { es: "Prototipo de una ducha ecointeligente: me encargué de la mecánica y del concepto.", en: "Prototype of an eco-smart shower: I handled the mechanics and the concept." },
  },
  {
    anio: "2024",
    titulo: { es: "Ganadora internacional del concurso de logo de Erasmus+", en: "International winner of the Erasmus+ logo contest" },
