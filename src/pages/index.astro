/* =====================================================================
   TODO EL PORTFOLIO. Se lee de arriba abajo:
   1. Tus datos (aquí escribes tú). Lo que cambia de idioma es { es: "...", en: "..." }
   2. El HTML de la página: cada <section class="pg"> es una "página"
   3. Los scripts, cada uno en su archivo (carpeta src/scripts/)
   ===================================================================== */
import "../styles/global.css";
import T from "../components/T.astro";
import Gotas from "../components/Gotas.astro";

// La web se publica en /portfolio-astro/ (ver "base" en astro.config.mjs).
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const ruta = (camino) => base + camino;

// ---------- 1. TUS DATOS ----------
const nombre = "Aurora Mañé";
const primerNombre = nombre.split(" ")[0];
const intro = {
  es: "Estudio desarrollo web y también dibujo. Me gusta que lo que construyo funcione bien y se entienda a la primera.",
  en: "I study web development and I also draw. I like what I build to work well and to be clear at first glance.",
};
const email = "auroramb2006@gmail.com";
const github = "https://github.com/auroramb2006-svg";
const linkedin = "https://www.linkedin.com/in/aurora-ma%C3%B1%C3%A9-bl%C3%A1zquez-362659388/";
const asunto = encodeURIComponent(`Hola ${primerNombre}, me gustaría hablar contigo`);
const foto = ruta("/img/pfp.jpg");

const menu = [
