/* =====================================================================
   ESTE ES TODO EL PORTFOLIO. Se lee de arriba abajo:
   1. Tus datos (aquí escribes tú)
   2. El HTML de la página
   3. Dos scripts, cada uno en su archivo (carpeta src/scripts/)

   La parte entre las rayas --- se ejecuta al construir la web.
   Después de las rayas empieza el HTML normal.
   ===================================================== */
import "../styles/global.css";

// Tu web se publica en /portfolio-astro/ (ver "base" en astro.config.mjs).
// Esta función añade ese prefijo a las rutas de las imágenes para que se encuentren.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const ruta = (camino) => base + camino;

// ---------- 1. TUS DATOS ----------
const nombre = "Aurora Mañé";
const intro =
  "Estudio desarrollo web y también dibujo. Me gusta que lo que construyo funcione bien y se entienda a la primera.";
const email = "auroramb2006@gmail.com";
const github = "https://github.com/auroramb2006-svg";
const linkedin = "https://www.linkedin.com/in/aurora-ma%C3%B1%C3%A9-bl%C3%A1zquez-362659388/";

const primerNombre = nombre.split(" ")[0];
const asunto = encodeURIComponent(
  `Hola ${primerNombre}, me gustaría hablar contigo`,
);

const menu = [
  { href: "#proyectos", titulo: "Proyectos", texto: "Lo que he construido" },
  { href: "#dibujos", titulo: "Dibujos", texto: "Lo que he dibujado" },
  {
    href: "#certificados",
    titulo: "Certificados",
    texto: "Lo que he estudiado",
  },
  { href: "#logros", titulo: "Logros", texto: "Lo que he conseguido" },
  { href: "#contacto", titulo: "Contacto", texto: "Hablemos" },
];

// Tus imágenes están en la carpeta public/img/.
// Cuando pongas las tuyas, cambia el nombre (y .svg por .jpg si hace falta).
const foto = ruta("/img/foto.svg");

const proyectos = [
  {
    nombre: "La Academia",
    fecha: "Jul-Ago 2026",
    img: ruta("/img/proyecto-1.svg"),
    alt: "Captura del proyecto uno",
    texto: "Una frase sobre qué hace y qué problema resuelve.",
    tecnologias: "Astro, Tailwind",
    demo: "#",
    codigo: "#",
  },
  {
    nombre: "Proyecto dos",
    fecha: "Abril de 2026",
    img: ruta("/img/proyecto-2.svg"),
    alt: "Captura del proyecto dos",
    texto: "Una frase sobre qué hace y qué problema resuelve.",
    tecnologias: "JavaScript, HTML, CSS",
    demo: "#",
    codigo: "#",
  },
];

const dibujos = [
  {
    img: ruta("/img/dibujo-1.svg"),
    alt: "Descripción del dibujo 1",
    titulo: "Dibujo 1",
  },
  {
    img: ruta("/img/dibujo-2.svg"),
    alt: "Descripción del dibujo 2",
    titulo: "Dibujo 2",
  },
  {
    img: ruta("/img/dibujo-3.svg"),
    alt: "Descripción del dibujo 3",
    titulo: "Dibujo 3",
  },
  {
    img: ruta("/img/dibujo-4.svg"),
    alt: "Descripción del dibujo 4",
    titulo: "Dibujo 4",
  },
];

const certificados = [
  {
    img: ruta("/img/cert-1.svg"),
    alt: "Certificado de JavaScript",
    titulo: "Curso de JavaScript",
    entidad: "Nombre de la entidad",
    anio: "2026",
  },
  {
    img: ruta("/img/cert-2.svg"),
    alt: "Certificado de HTML y CSS",
    titulo: "HTML y CSS",
    entidad: "Nombre de la entidad",
    anio: "2025",
  },
  {
    img: ruta("/img/cert-3.svg"),
    alt: "Certificado de inglés",
    titulo: "Inglés B1",
    entidad: "Nombre de la entidad",
    anio: "2025",
  },
];

// En los logros la foto es opcional: si no quieres foto, borra la línea "img" y "alt".
const logros = [
  {
    anio: "2026",
    titulo: "Primer premio en el concurso del centro",
    texto: "Una frase sobre qué hiciste.",
    img: ruta("/img/logro-1.svg"),
    alt: "Foto de la entrega del premio",
  },
  {
    anio: "2025",
    titulo: "Mi primer proyecto publicado",
    texto: "Una frase sobre qué aprendiste.",
  },
];
---

<!-- ---------- 2. EL HTML ---------- -->
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{nombre} | Portfolio</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400..700&family=Hanken+Grotesk:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Aplica el tema guardado antes de mostrar la página, para que no parpadee
      try {
        const t = localStorage.getItem("tema");
        if (t) document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>

  <body>
    <div class="mx-auto max-w-5xl px-6">
      <!-- Cabecera: nombre, menú, botón de tema y botón de contacto -->
      <header
        class="flex flex-wrap items-center justify-between gap-6 py-8"
      >
        <a href="#" class="font-semibold">{nombre}</a>
        <nav class="flex flex-wrap gap-x-6 gap-y-3">
          {
            menu.map((m) => (
              <a href={m.href} class="block leading-tight">
                <span class="block text-sm font-medium">{m.titulo}</span>
                <span class="muted hidden text-xs md:block">{m.texto}</span>
              </a>
            ))
          }
        </nav>
        <div class="flex items-center gap-3">
          <button
            id="boton-tema"
            type="button"
            class="line muted rounded-full border px-3 text-sm"></button>
          <a class="boton" href={`mailto:${email}?subject=${asunto}`}
            >Escríbeme</a
          >
        </div>
      </header>

      <main>
        <!-- Portada -->
        <section
          class="mb-16 rounded-3xl px-8 py-14 md:px-14 md:py-20"
          style="background: var(--hero)"
        >
          <div class="md:flex md:items-center md:justify-between md:gap-12">
            <div class="max-w-2xl">
              <h1 class="text-5xl leading-[1.05] font-semibold md:text-7xl">
                Hola, soy {primerNombre}.
              </h1>
              <p class="mt-6 text-lg md:text-xl">{intro}</p>
              <a
                class="boton mt-8"
                href={`mailto:${email}?subject=${asunto}`}>Escríbeme</a
              >
            </div>
            <img
              src={foto}
              alt={`Foto de ${nombre}`}
              class="mt-10 h-40 w-40 rounded-full border-4 border-white/50 object-cover md:mt-0 md:h-56 md:w-56"
            />
          </div>
        </section>

        <!-- Proyectos: .map() crea una tarjeta por cada proyecto de la lista -->
        <section id="proyectos" class="line scroll-mt-4 border-t py-24">
          <h2 class="text-3xl font-semibold md:text-4xl">Proyectos</h2>
          <div class="mt-8 grid gap-6 md:grid-cols-2">
            {
              proyectos.map((p) => (
                <article
                  class="line overflow-hidden rounded-2xl border"
                  style="background: var(--card)"
                >
                  <img
                    src={p.img}
                    alt={p.alt}
                    loading="lazy"
                    class="aspect-[16/9] w-full object-cover"
                  />
                  <div class="p-6">
                    <p class="muted text-sm">{p.fecha}</p>
                    <h3 class="mt-1 text-xl font-semibold">{p.nombre}</h3>
                    <p class="mt-2">{p.texto}</p>
                    <p class="muted mt-2 text-sm">{p.tecnologias}</p>
                    <p class="mt-4 flex gap-5 text-sm">
                      <a class="link" href={p.demo}>
                        Ver demo
                      </a>
                      <a class="link" href={p.codigo}>
                        Ver código
                      </a>
                    </p>
                  </div>
                </article>
              ))
            }
          </div>
        </section>

        <!-- Dibujos: columnas tipo mosaico. data-grupo agrupa las imágenes del visor -->
        <section id="dibujos" class="line scroll-mt-4 border-t py-24">
          <h2 class="text-3xl font-semibold md:text-4xl">Dibujos</h2>
          <p class="muted mt-2">Pulsa en una imagen para verla grande.</p>
          <div class="mt-8 columns-2 gap-4 md:columns-3">
            {
              dibujos.map((d) => (
                <button
                  type="button"
                  class="thumb mb-4 break-inside-avoid"
                  data-grupo="dibujos"
                  data-img={d.img}
                  data-alt={d.alt}
                  data-titulo={d.titulo}
                >
                  <img src={d.img} alt={d.alt} loading="lazy" />
                </button>
              ))
            }
          </div>
        </section>

        <!-- Certificados -->
        <section id="certificados" class="line scroll-mt-4 border-t py-24">
          <h2 class="text-3xl font-semibold md:text-4xl">Certificados</h2>
          <div class="mt-8 grid gap-6 sm:grid-cols-2 md:grid-cols-3">
            {
              certificados.map((c) => (
                <figure>
                  <button
                    type="button"
                    class="thumb"
                    data-grupo="certificados"
                    data-img={c.img}
                    data-alt={c.alt}
                    data-titulo={c.titulo}
                  >
                    <img
                      src={c.img}
                      alt={c.alt}
                      loading="lazy"
                      class="aspect-[4/3] object-cover"
                    />
                  </button>
                  <figcaption class="mt-3">
                    <p class="font-medium">{c.titulo}</p>
                    <p class="muted text-sm">
                      {c.entidad} · {c.anio}
                    </p>
                  </figcaption>
                </figure>
              ))
            }
          </div>
        </section>

        <!-- Logros -->
        <section id="logros" class="line scroll-mt-4 border-t py-24">
          <h2 class="text-3xl font-semibold md:text-4xl">Logros</h2>
          <div class="mt-8">
            {
              logros.map((l) => (
                <div class="line grid gap-4 border-t py-6 first:border-t-0 first:pt-0 md:grid-cols-[6rem_1fr_12rem]">
                  <p class="muted">{l.anio}</p>
                  <div>
                    <h3 class="font-semibold">{l.titulo}</h3>
                    <p class="muted mt-1">{l.texto}</p>
                  </div>
                  <div>
                    {l.img && (
                      <button
                        type="button"
                        class="thumb"
                        data-grupo="logros"
                        data-img={l.img}
                        data-alt={l.alt}
                        data-titulo={l.titulo}
                      >
                        <img src={l.img} alt={l.alt} loading="lazy" />
                      </button>
                    )}
                  </div>
                </div>
              ))
            }
          </div>
        </section>

        <!-- Contacto -->
        <section id="contacto" class="line scroll-mt-4 border-t py-24">
          <h2 class="text-3xl font-semibold md:text-4xl">Contacto</h2>
          <p class="mt-6">
            <a class="link text-lg" href={`mailto:${email}`}>{email}</a>
          </p>
          <p class="muted mt-4 flex gap-6">
            <a class="link" href={github}>GitHub</a>
            <a class="link" href={linkedin}>LinkedIn</a>
          </p>
        </section>
      </main>

      <footer class="line muted border-t py-8 text-sm">
        © {new Date().getFullYear()}
        {nombre} · Hecho en tu ciudad.
      </footer>
    </div>

    <!-- Visor: ventana que se abre al pulsar una imagen -->
    <dialog id="visor">
      <img id="visor-img" alt="" />
      <p id="visor-texto" class="mt-3 text-center text-sm"></p>
      <div class="mt-3 flex justify-center gap-3">
        <button type="button" id="anterior">← Anterior</button>
        <button type="button" id="cerrar">Cerrar</button>
        <button type="button" id="siguiente">Siguiente →</button>
      </div>
    </dialog>
  </body>
</html>

<!-- ---------- 3. SCRIPTS ---------- -->
<script>
  import "../scripts/tema.js";
  import "../scripts/visor.js";
</script>
