---
const { animar = false } = Astro.props;
const gotas = [[60,64,76],[180,64,112],[300,56,52],[390,64,90],[520,64,66],[640,72,116],[770,56,60],[860,64,96]];
---
<svg class="gotas" viewBox="0 0 1000 130" preserveAspectRatio="xMidYMin slice" aria-hidden="true">
  <g filter="url(#goo)" style="fill:var(--hero)">
    <rect x="-60" y="-40" width="1120" height="70" />
    {gotas.map(([x, w, h], i) => (
      <rect class={animar ? "dp" : ""} style={`--d:${i * 0.07}s`} x={x} y="10" width={w} height={h} rx={w / 2} />
    ))}
  </g>
</svg>